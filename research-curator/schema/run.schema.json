{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/research-curator/run.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "freshness": {
          "type": "string",
          "minLength": 1
        },
        "preferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "depth": {
          "type": "string",
          "minLength": 1
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "question",
        "types",
        "excludes",
        "freshness",
        "preferences",
        "quantity",
        "depth",
        "questions"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "original": {
            "type": "boolean"
          },
          "published_at": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          },
          "content_hash": {
            "type": "string",
            "minLength": 1
          },
          "upstream_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "freshness": {
            "type": "string",
            "minLength": 1
          },
          "fit": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "utility": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "selected",
              "rejected",
              "duplicate",
              "superseded"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "duplicate_of": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "failed"
            ]
          },
          "fit_reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_reason": {
            "type": "string",
            "minLength": 1
          },
          "utility_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "type",
          "original",
          "retrieved_at",
          "content",
          "upstream_ids",
          "freshness",
          "fit",
          "evidence",
          "utility",
          "status",
          "reason",
          "verification",
          "fit_reason",
          "evidence_reason",
          "utility_reason"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "question_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "supports",
                    "contradicts"
                  ]
                },
                "verification": {
                  "type": "string",
                  "enum": [
                    "verified",
                    "unverified",
                    "failed"
                  ]
                }
              },
              "required": [
                "source_id",
                "quote",
                "locator",
                "relation",
                "verification"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "text",
          "question_ids",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "conclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "failed"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "claim_ids",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "Goal",
                  "Question",
                  "Claim",
                  "Source",
                  "Conclusion"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "type",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "supports",
                  "contradicts",
                  "duplicates",
                  "derives_from",
                  "replaces",
                  "contains",
                  "addresses"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "type"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "question_id",
          "text",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "enum": [
              "Requirement First",
              "Discovery",
              "Normalize",
              "Deduplicate",
              "Qualify",
              "Verify",
              "Claim Extraction",
              "Evidence Graph",
              "Coverage Check",
              "Rank",
              "Synthesis"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "before_count": {
            "type": "integer",
            "minimum": 0
          },
          "after_count": {
            "type": "integer",
            "minimum": 0
          },
          "count_scope": {
            "type": "string",
            "enum": [
              "candidates",
              "selected_sources"
            ]
          }
        },
        "required": [
          "id",
          "at",
          "stage",
          "action",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "at",
          "source_id",
          "action",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "Requirement First",
              "Discovery",
              "Normalize",
              "Deduplicate",
              "Qualify",
              "Verify",
              "Claim Extraction",
              "Evidence Graph",
              "Coverage Check",
              "Rank",
              "Synthesis"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "failed"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "status",
          "evidence_ids",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "failed"
          ]
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "type": "string",
                "minLength": 1
              },
              "claim_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "independent_sources": {
                "type": "integer",
                "minimum": 0
              },
              "gaps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "question_id",
              "claim_ids",
              "independent_sources",
              "gaps"
            ],
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "questions",
        "warnings"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "completed_at": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "in_progress",
            "finalized",
            "failed"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "search_provenance": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "created_at",
        "completed_at",
        "status",
        "tools",
        "search_provenance"
      ],
      "additionalProperties": false
    },
    "rejected_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "id",
    "contract",
    "sources",
    "claims",
    "conclusions",
    "graph",
    "queries",
    "events",
    "decisions",
    "stages",
    "coverage",
    "metadata",
    "rejected_sources"
  ],
  "additionalProperties": false
}
